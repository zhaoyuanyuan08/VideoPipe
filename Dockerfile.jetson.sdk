ARG L4T_TAG=r36.4.0
FROM nvcr.io/nvidia/l4t-jetpack:${L4T_TAG}

ENV DEBIAN_FRONTEND=noninteractive
ENV VP_ROOT=/workspace/VideoPipe
ENV TENSORRT_ROOT=/workspace/jetson_tensorrt
ENV VP_BUILD_DIR=/workspace/VideoPipe/build-jetson-sdk
ENV LD_LIBRARY_PATH=/workspace/VideoPipe/build-jetson-sdk/libs:/workspace/VideoPipe/build-jetson-sdk/sdk:/workspace/jetson_tensorrt/lib:/usr/local/cuda/lib64:${LD_LIBRARY_PATH}
ENV PYTHONPATH=/workspace/VideoPipe/build-jetson-sdk/python:${PYTHONPATH}

WORKDIR /workspace

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    ca-certificates \
    cmake \
    git \
    pkg-config \
    python3 \
    python3-dev \
    python3-pip \
    python3-opencv \
    libopencv-dev \
    libgstreamer1.0-dev \
    libgstreamer-plugins-base1.0-dev \
    libgstrtspserver-1.0-dev \
    gstreamer1.0-tools \
    gstreamer1.0-plugins-base \
    gstreamer1.0-plugins-good \
    gstreamer1.0-plugins-bad \
    gstreamer1.0-libav \
    && rm -rf /var/lib/apt/lists/*

RUN mkdir -p /workspace/jetson_tensorrt \
    && ln -sfn /usr/include/aarch64-linux-gnu /workspace/jetson_tensorrt/include \
    && ln -sfn /usr/lib/aarch64-linux-gnu /workspace/jetson_tensorrt/lib

COPY . ${VP_ROOT}

RUN cmake -S ${VP_ROOT} -B ${VP_BUILD_DIR} \
      -DVP_WITH_TENSORRT_RUNTIME=ON \
      -DVP_BUILD_SDK=ON \
      -DTENSORRT_ROOT=${TENSORRT_ROOT} \
      -DVP_WITH_ONNXRUNTIME=OFF \
      -DVP_WITH_CUDA=OFF \
      -DVP_WITH_TRT=OFF \
      -DVP_WITH_PADDLE=OFF \
      -DVP_WITH_KAFKA=OFF \
      -DVP_WITH_LLM=OFF \
      -DVP_WITH_FFMPEG=OFF \
    && cmake --build ${VP_BUILD_DIR} \
      --target videopipe_sdk_cpp videopipe_sdk_file_sample videopipe_sdk \
      -j$(nproc)

RUN chmod +x ${VP_ROOT}/scripts/jetson_sdk_entrypoint.sh

ENTRYPOINT ["/workspace/VideoPipe/scripts/jetson_sdk_entrypoint.sh"]
CMD ["python3"]
